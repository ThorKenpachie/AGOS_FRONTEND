# Copy to .env for local development (.env is git-ignored — never commit
# real secrets). Vercel's own Environment Variables settings are what
# actually control the deployed production build; this file exists so the
# expected variables and production values are documented somewhere in the
# repo instead of only living in one person's local .env or Vercel account.

# ── Supabase ─────────────────────────────────────────────────────────────
# Same project for both local dev and production — see Project Settings →
# API in the Supabase dashboard.
VITE_SUPABASE_URL=https://niegqxcfixwixrwxlazc.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Flood-forecast model API ─────────────────────────────────────────────
# 'live' data source (the dashboard's default, toggled via the Topbar)
# reads VITE_LIVE_URL. No automatic fallback — if this host is unreachable
# the Dashboard correctly shows "Model backend offline" instead of quietly
# switching to another server.
#
# Production (set this in Vercel's dashboard, not here):
#   VITE_LIVE_URL=https://agos-ai-model.onrender.com
#
# Local development (what this file documents — override in your own
# .env to point at AI_Model/main.py running on your machine instead, so
# you can test backend changes before redeploying to Render):
VITE_LIVE_URL=http://127.0.0.1:8000
VITE_MOCK_URL=http://127.0.0.1:8000
